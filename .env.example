# WordPress backend (REST API)
NEXT_PUBLIC_WP_URL=https://admin.vakilmajd.com
NEXT_PUBLIC_SITE_URL=https://vakilmajd.com

# Server-only — must match MAJD_WP_API_KEY in wp-config.php on the WordPress host.
# Used at build time (generateStaticParams, sitemap). Never commit a real value here.
# Generate: openssl rand -hex 32
WP_API_KEY=

# If Node build fails with UNABLE_TO_VERIFY_LEAF_SIGNATURE, either fix the WP TLS chain
# or run build with TLS verification disabled (local only):
#   PowerShell: $env:NODE_TLS_REJECT_UNAUTHORIZED='0'; npm run build

# WooCommerce Store API (public catalog + headless cart)
# Products: GET /wp-json/wc/store/v1/products
# Cart:    GET/POST /wp-json/wc/store/v1/cart/...
# Checkout: POST /wp-json/wc/store/v1/checkout

# Payment gateway ID from WooCommerce (e.g. zarinpal, WC_ZPal, cod)
NEXT_PUBLIC_WC_PAYMENT_METHOD=zarinpal

# WordPress setup required for headless cart:
# 1. Create WooCommerce products with slugs matching productSlug in src/data/courses.ts
# 2. Install payment gateway (Zarinpal, IDPay, etc.)
# 3. Add CORS mu-plugin allowing NEXT_PUBLIC_SITE_URL origin
#    and expose headers: Cart-Token, Nonce
# 4. Set gateway return URL to: {NEXT_PUBLIC_SITE_URL}/checkout/success/
