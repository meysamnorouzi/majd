# SPA fallbacks for client-rendered detail routes (static Next.js export).
# Equivalent to public/_redirects — required on Apache / LiteSpeed / cPanel.
#
# Without these rules, posts/products/courses published after the last
# build (or Persian slugs not present as folders) return Apache 404.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Prefer trailing-slash URLs (matches Next trailingSlash: true)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # Legacy blog URLs
  RewriteRule ^blog/post/(.+)/?$ /blogs/$1/ [R=301,L]
  RewriteRule ^blog/?$ /blogs/ [R=301,L]

  # Blog post shell: /blogs/<slug>/ → /blogs/view/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^blogs/[^/]+/?$ /blogs/view/index.html [L]

  # Service detail shell: /services/<slug>/ → /services/detail/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^services/.+$ /services/detail/index.html [L]

  # Shop product shell
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^shop/product/.+$ /shop/product/index.html [L]

  # Course detail shell
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^courses/view/.+$ /courses/view/index.html [L]
</IfModule>
