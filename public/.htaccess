# SPA fallbacks for client-rendered detail routes (static Next.js export).
# Equivalent to public/_redirects — required on Apache / LiteSpeed / cPanel.
#
# Without these rules, posts/products/courses published after the last
# build (or Persian slugs not present as folders) return Apache 404.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

# BEGIN majd:legacy-redirects
# generated by scripts/generate-redirects.mjs from src/data/legacy-redirects.json — do not edit by hand
#
# Apache decodes the request URI before matching, so the REQUEST_URI condition
# carries the literal Persian path and the THE_REQUEST condition covers hosts
# that hand mod_rewrite the raw percent-encoded request line. NE keeps the
# already-encoded target from being escaped a second time.

# ریدایرکت روی صفحه تقسیم ترکه و حذف از زیرمنو ملکی
# /services/وکیل-ملک-ورثه-ای/ → /services/بهترین-وکیل-تقسیم-ترکه/
RewriteCond %{REQUEST_URI} ^/services/وکیل-ملک-ورثه-ای/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D9%84%DA%A9-%D9%88%D8%B1%D8%AB%D9%87-%D8%A7%DB%8C/?[\s?]
RewriteRule ^ /services/%D8%A8%D9%87%D8%AA%D8%B1%DB%8C%D9%86-%D9%88%DA%A9%DB%8C%D9%84-%D8%AA%D9%82%D8%B3%DB%8C%D9%85-%D8%AA%D8%B1%DA%A9%D9%87/ [R=301,L,NE]

# ریدایرکت روی صفحه وکیل خلع ید و تخلیه
# /services/وکیل-تصرف-عدوانی/ → /وکیل-خلع-ید/
RewriteCond %{REQUEST_URI} ^/services/وکیل-تصرف-عدوانی/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D8%AA%D8%B5%D8%B1%D9%81-%D8%B9%D8%AF%D9%88%D8%A7%D9%86%DB%8C/?[\s?]
RewriteRule ^ /%D9%88%DA%A9%DB%8C%D9%84-%D8%AE%D9%84%D8%B9-%DB%8C%D8%AF/ [R=301,L,NE]

# ریدایرکت روی صفحه وکیل خلع ید و تخلیه
# /services/وکیل-تخلیه-ملک-در-تهران/ → /وکیل-خلع-ید/
RewriteCond %{REQUEST_URI} ^/services/وکیل-تخلیه-ملک-در-تهران/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D8%AA%D8%AE%D9%84%DB%8C%D9%87-%D9%85%D9%84%DA%A9-%D8%AF%D8%B1-%D8%AA%D9%87%D8%B1%D8%A7%D9%86/?[\s?]
RewriteRule ^ /%D9%88%DA%A9%DB%8C%D9%84-%D8%AE%D9%84%D8%B9-%DB%8C%D8%AF/ [R=301,L,NE]

# ریدایرکت ۳۰۱ روی صفحه هاب ملکی
# /services/وکیل-متخصص-املاک/ → /services/ملکی/
RewriteCond %{REQUEST_URI} ^/services/وکیل-متخصص-املاک/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D8%AA%D8%AE%D8%B5%D8%B5-%D8%A7%D9%85%D9%84%D8%A7%DA%A9/?[\s?]
RewriteRule ^ /services/%D9%85%D9%84%DA%A9%DB%8C/ [R=301,L,NE]

# ریدایرکت ۳۰۱ روی صفحه هاب ملکی
# /services/وکیل-ملکی-در-تهرانپارس/ → /services/ملکی/
RewriteCond %{REQUEST_URI} ^/services/وکیل-ملکی-در-تهرانپارس/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D9%84%DA%A9%DB%8C-%D8%AF%D8%B1-%D8%AA%D9%87%D8%B1%D8%A7%D9%86%D9%BE%D8%A7%D8%B1%D8%B3/?[\s?]
RewriteRule ^ /services/%D9%85%D9%84%DA%A9%DB%8C/ [R=301,L,NE]

# ریدایرکت ۳۰۱ روی صفحه هاب ملکی
# /services/وکیل-زمین-در-شرق-تهران/ → /services/ملکی/
RewriteCond %{REQUEST_URI} ^/services/وکیل-زمین-در-شرق-تهران/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D8%B2%D9%85%DB%8C%D9%86-%D8%AF%D8%B1-%D8%B4%D8%B1%D9%82-%D8%AA%D9%87%D8%B1%D8%A7%D9%86/?[\s?]
RewriteRule ^ /services/%D9%85%D9%84%DA%A9%DB%8C/ [R=301,L,NE]

# ریدایرکت ۳۰۱ روی صفحه هاب ملکی
# /services/وکیل-ملکی-شرق-تهران/ → /services/ملکی/
RewriteCond %{REQUEST_URI} ^/services/وکیل-ملکی-شرق-تهران/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D9%84%DA%A9%DB%8C-%D8%B4%D8%B1%D9%82-%D8%AA%D9%87%D8%B1%D8%A7%D9%86/?[\s?]
RewriteRule ^ /services/%D9%85%D9%84%DA%A9%DB%8C/ [R=301,L,NE]

# ریدایرکت روی وکیل سرقفلی (صفحه بازگردانی‌شده)
# /services/وکیل-سرقفلی/ → /وکیل-متخصص-سرقفلی/
RewriteCond %{REQUEST_URI} ^/services/وکیل-سرقفلی/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D8%B3%D8%B1%D9%82%D9%81%D9%84%DB%8C/?[\s?]
RewriteRule ^ /%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D8%AA%D8%AE%D8%B5%D8%B5-%D8%B3%D8%B1%D9%82%D9%81%D9%84%DB%8C/ [R=301,L,NE]

# ریدایرکت روی مشاوره حقوقی
# /services/بهترین-وکیل/ → /services/moshavere-hoghooghi/
RewriteCond %{REQUEST_URI} ^/services/بهترین-وکیل/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D8%A8%D9%87%D8%AA%D8%B1%DB%8C%D9%86-%D9%88%DA%A9%DB%8C%D9%84/?[\s?]
RewriteRule ^ /services/moshavere-hoghooghi/ [R=301,L,NE]

# تبدیل به بلاگ پست
# /services/سگی-که-خانه-میلیاردی-به-نام-وی-شد/ → /blogs/سگی-که-خانه-میلیاردی-به-نام-وی-شد/
RewriteCond %{REQUEST_URI} ^/services/سگی-که-خانه-میلیاردی-به-نام-وی-شد/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D8%B3%DA%AF%DB%8C-%DA%A9%D9%87-%D8%AE%D8%A7%D9%86%D9%87-%D9%85%DB%8C%D9%84%DB%8C%D8%A7%D8%B1%D8%AF%DB%8C-%D8%A8%D9%87-%D9%86%D8%A7%D9%85-%D9%88%DB%8C-%D8%B4%D8%AF/?[\s?]
RewriteRule ^ /blogs/%D8%B3%DA%AF%DB%8C-%DA%A9%D9%87-%D8%AE%D8%A7%D9%86%D9%87-%D9%85%DB%8C%D9%84%DB%8C%D8%A7%D8%B1%D8%AF%DB%8C-%D8%A8%D9%87-%D9%86%D8%A7%D9%85-%D9%88%DB%8C-%D8%B4%D8%AF/ [R=301,L,NE]

# تبدیل به بلاگ پست
# /services/احکام-صادره-برای-املاک-خاص/ → /blogs/احکام-صادره-برای-املاک-خاص/
RewriteCond %{REQUEST_URI} ^/services/احکام-صادره-برای-املاک-خاص/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D8%A7%D8%AD%DA%A9%D8%A7%D9%85-%D8%B5%D8%A7%D8%AF%D8%B1%D9%87-%D8%A8%D8%B1%D8%A7%DB%8C-%D8%A7%D9%85%D9%84%D8%A7%DA%A9-%D8%AE%D8%A7%D8%B5/?[\s?]
RewriteRule ^ /blogs/%D8%A7%D8%AD%DA%A9%D8%A7%D9%85-%D8%B5%D8%A7%D8%AF%D8%B1%D9%87-%D8%A8%D8%B1%D8%A7%DB%8C-%D8%A7%D9%85%D9%84%D8%A7%DA%A9-%D8%AE%D8%A7%D8%B5/ [R=301,L,NE]

# تبدیل به بلاگ پست
# /services/اصل-۴۹-قانون-اساسی/ → /blogs/اصل-۴۹-قانون-اساسی/
RewriteCond %{REQUEST_URI} ^/services/اصل-۴۹-قانون-اساسی/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D8%A7%D8%B5%D9%84-%DB%B4%DB%B9-%D9%82%D8%A7%D9%86%D9%88%D9%86-%D8%A7%D8%B3%D8%A7%D8%B3%DB%8C/?[\s?]
RewriteRule ^ /blogs/%D8%A7%D8%B5%D9%84-%DB%B4%DB%B9-%D9%82%D8%A7%D9%86%D9%88%D9%86-%D8%A7%D8%B3%D8%A7%D8%B3%DB%8C/ [R=301,L,NE]

# END majd:legacy-redirects


  # Prefer trailing-slash URLs (matches Next trailingSlash: true)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # Legacy blog URLs
  RewriteRule ^blog/post/(.+)/?$ /blogs/$1/ [R=301,L]
  RewriteRule ^blog/?$ /blogs/ [R=301,L]

  # Blog post shell: /blogs/<slug>/ → /blogs/view/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^blogs/[^/]+/?$ /blogs/view/index.html [L]

  # Service detail shell: /services/<slug>/ → /services/detail/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^services/.+$ /services/detail/index.html [L]

  # Shop product shell
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^shop/product/.+$ /shop/product/index.html [L]

  # Course detail shell
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^courses/view/.+$ /courses/view/index.html [L]
</IfModule>
