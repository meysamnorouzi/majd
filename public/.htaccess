# SPA fallbacks for client-rendered detail routes (static Next.js export).
# Equivalent to public/_redirects — required on Apache / LiteSpeed / cPanel.
#
# Without these rules, posts/products/courses published after the last
# build (or Persian slugs not present as folders) return Apache 404.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

# BEGIN majd:legacy-redirects
# generated by scripts/generate-redirects.mjs from src/data/legacy-redirects.json — do not edit by hand
#
# Apache decodes the request URI before matching, so the REQUEST_URI condition
# carries the literal Persian path and the THE_REQUEST condition covers hosts
# that hand mod_rewrite the raw percent-encoded request line. NE keeps the
# already-encoded target from being escaped a second time.

# ریدایرکت روی صفحه تقسیم ترکه و حذف از زیرمنو ملکی
# /services/وکیل-ملک-ورثه-ای/ → /property-lawyer/وکیل-تقسیم-ترکه/
RewriteCond %{REQUEST_URI} ^/services/وکیل-ملک-ورثه-ای/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D9%84%DA%A9-%D9%88%D8%B1%D8%AB%D9%87-%D8%A7%DB%8C/?[\s?]
RewriteRule ^ /property-lawyer/%D9%88%DA%A9%DB%8C%D9%84-%D8%AA%D9%82%D8%B3%DB%8C%D9%85-%D8%AA%D8%B1%DA%A9%D9%87/ [R=301,L,NE]

# آدرس ریشه‌ای رنک‌دار به ساختار جدید خدمات ملکی منتقل شد
# /وکیل-خلع-ید/ → /property-lawyer/وکیل-خلع-ید/
RewriteCond %{REQUEST_URI} ^/وکیل-خلع-ید/?$ [OR]
RewriteCond %{THE_REQUEST} \s/%D9%88%DA%A9%DB%8C%D9%84-%D8%AE%D9%84%D8%B9-%DB%8C%D8%AF/?[\s?]
RewriteRule ^ /property-lawyer/%D9%88%DA%A9%DB%8C%D9%84-%D8%AE%D9%84%D8%B9-%DB%8C%D8%AF/ [R=301,L,NE]

# ریدایرکت روی صفحه وکیل خلع ید و تخلیه
# /services/وکیل-تصرف-عدوانی/ → /property-lawyer/وکیل-خلع-ید-و-تخلیه/
RewriteCond %{REQUEST_URI} ^/services/وکیل-تصرف-عدوانی/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D8%AA%D8%B5%D8%B1%D9%81-%D8%B9%D8%AF%D9%88%D8%A7%D9%86%DB%8C/?[\s?]
RewriteRule ^ /property-lawyer/%D9%88%DA%A9%DB%8C%D9%84-%D8%AE%D9%84%D8%B9-%DB%8C%D8%AF-%D9%88-%D8%AA%D8%AE%D9%84%DB%8C%D9%87/ [R=301,L,NE]

# ریدایرکت روی صفحه وکیل خلع ید و تخلیه
# /services/وکیل-تخلیه-ملک-در-تهران/ → /property-lawyer/وکیل-خلع-ید-و-تخلیه/
RewriteCond %{REQUEST_URI} ^/services/وکیل-تخلیه-ملک-در-تهران/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D8%AA%D8%AE%D9%84%DB%8C%D9%87-%D9%85%D9%84%DA%A9-%D8%AF%D8%B1-%D8%AA%D9%87%D8%B1%D8%A7%D9%86/?[\s?]
RewriteRule ^ /property-lawyer/%D9%88%DA%A9%DB%8C%D9%84-%D8%AE%D9%84%D8%B9-%DB%8C%D8%AF-%D9%88-%D8%AA%D8%AE%D9%84%DB%8C%D9%87/ [R=301,L,NE]

# ریدایرکت صفحه هاب ملکی — دسته‌بندی‌ها صفحه مستقل ندارند
# /services/وکیل-متخصص-املاک/ → /property-lawyer/
RewriteCond %{REQUEST_URI} ^/services/وکیل-متخصص-املاک/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D8%AA%D8%AE%D8%B5%D8%B5-%D8%A7%D9%85%D9%84%D8%A7%DA%A9/?[\s?]
RewriteRule ^ /property-lawyer/ [R=301,L,NE]

# ریدایرکت صفحه هاب ملکی — دسته‌بندی‌ها صفحه مستقل ندارند
# /services/وکیل-ملکی-در-تهرانپارس/ → /property-lawyer/
RewriteCond %{REQUEST_URI} ^/services/وکیل-ملکی-در-تهرانپارس/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D9%84%DA%A9%DB%8C-%D8%AF%D8%B1-%D8%AA%D9%87%D8%B1%D8%A7%D9%86%D9%BE%D8%A7%D8%B1%D8%B3/?[\s?]
RewriteRule ^ /property-lawyer/ [R=301,L,NE]

# ریدایرکت صفحه هاب ملکی — دسته‌بندی‌ها صفحه مستقل ندارند
# /services/وکیل-زمین-در-شرق-تهران/ → /property-lawyer/
RewriteCond %{REQUEST_URI} ^/services/وکیل-زمین-در-شرق-تهران/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D8%B2%D9%85%DB%8C%D9%86-%D8%AF%D8%B1-%D8%B4%D8%B1%D9%82-%D8%AA%D9%87%D8%B1%D8%A7%D9%86/?[\s?]
RewriteRule ^ /property-lawyer/ [R=301,L,NE]

# ریدایرکت صفحه هاب ملکی — دسته‌بندی‌ها صفحه مستقل ندارند
# /services/وکیل-ملکی-شرق-تهران/ → /property-lawyer/
RewriteCond %{REQUEST_URI} ^/services/وکیل-ملکی-شرق-تهران/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D9%84%DA%A9%DB%8C-%D8%B4%D8%B1%D9%82-%D8%AA%D9%87%D8%B1%D8%A7%D9%86/?[\s?]
RewriteRule ^ /property-lawyer/ [R=301,L,NE]

# آدرس ریشه‌ای امور خانواده به صفحه وکیل متخصص دعاوی خانواده
# /وکیل-امور-خانواده/ → /family-lawyer/وکیل-متخصص-دعاوی-خانواده/
RewriteCond %{REQUEST_URI} ^/وکیل-امور-خانواده/?$ [OR]
RewriteCond %{THE_REQUEST} \s/%D9%88%DA%A9%DB%8C%D9%84-%D8%A7%D9%85%D9%88%D8%B1-%D8%AE%D8%A7%D9%86%D9%88%D8%A7%D8%AF%D9%87/?[\s?]
RewriteRule ^ /family-lawyer/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D8%AA%D8%AE%D8%B5%D8%B5-%D8%AF%D8%B9%D8%A7%D9%88%DB%8C-%D8%AE%D8%A7%D9%86%D9%88%D8%A7%D8%AF%D9%87/ [R=301,L,NE]

# آدرس ریشه‌ای سرقفلی به ساختار جدید خدمات ملکی منتقل شد
# /وکیل-متخصص-سرقفلی/ → /property-lawyer/وکیل-متخصص-سرقفلی/
RewriteCond %{REQUEST_URI} ^/وکیل-متخصص-سرقفلی/?$ [OR]
RewriteCond %{THE_REQUEST} \s/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D8%AA%D8%AE%D8%B5%D8%B5-%D8%B3%D8%B1%D9%82%D9%81%D9%84%DB%8C/?[\s?]
RewriteRule ^ /property-lawyer/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D8%AA%D8%AE%D8%B5%D8%B5-%D8%B3%D8%B1%D9%82%D9%81%D9%84%DB%8C/ [R=301,L,NE]

# ریدایرکت روی وکیل متخصص سرقفلی
# /services/وکیل-سرقفلی/ → /property-lawyer/وکیل-متخصص-سرقفلی/
RewriteCond %{REQUEST_URI} ^/services/وکیل-سرقفلی/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D8%B3%D8%B1%D9%82%D9%81%D9%84%DB%8C/?[\s?]
RewriteRule ^ /property-lawyer/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D8%AA%D8%AE%D8%B5%D8%B5-%D8%B3%D8%B1%D9%82%D9%81%D9%84%DB%8C/ [R=301,L,NE]

# انتقال به ساختار جدید خدمات کیفری — بدون noindex
# /services/وکیل-قتل/ → /criminal-defense-lawyer/وکیل-قتل/
RewriteCond %{REQUEST_URI} ^/services/وکیل-قتل/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D9%82%D8%AA%D9%84/?[\s?]
RewriteRule ^ /criminal-defense-lawyer/%D9%88%DA%A9%DB%8C%D9%84-%D9%82%D8%AA%D9%84/ [R=301,L,NE]

# انتقال به ساختار جدید خدمات ملکی — بدون noindex
# /services/وکیل-متخصص-سرقفلی/ → /property-lawyer/وکیل-متخصص-سرقفلی/
RewriteCond %{REQUEST_URI} ^/services/وکیل-متخصص-سرقفلی/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D8%AA%D8%AE%D8%B5%D8%B5-%D8%B3%D8%B1%D9%82%D9%81%D9%84%DB%8C/?[\s?]
RewriteRule ^ /property-lawyer/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D8%AA%D8%AE%D8%B5%D8%B5-%D8%B3%D8%B1%D9%82%D9%81%D9%84%DB%8C/ [R=301,L,NE]

# هاب ملکی به پیلار وکیل ملکی منتقل شد
# /services/وکیل-ملکی/ → /property-lawyer/
RewriteCond %{REQUEST_URI} ^/services/وکیل-ملکی/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D9%84%DA%A9%DB%8C/?[\s?]
RewriteRule ^ /property-lawyer/ [R=301,L,NE]

# انتقال به صفحه وکیل متخصص دعاوی خانواده — بدون noindex
# /services/وکیل-خانواده/ → /family-lawyer/وکیل-متخصص-دعاوی-خانواده/
RewriteCond %{REQUEST_URI} ^/services/وکیل-خانواده/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D8%AE%D8%A7%D9%86%D9%88%D8%A7%D8%AF%D9%87/?[\s?]
RewriteRule ^ /family-lawyer/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D8%AA%D8%AE%D8%B5%D8%B5-%D8%AF%D8%B9%D8%A7%D9%88%DB%8C-%D8%AE%D8%A7%D9%86%D9%88%D8%A7%D8%AF%D9%87/ [R=301,L,NE]

# انتقال به ساختار جدید خدمات کیفری — بدون noindex
# /services/وکیل-رابطه-نامشروع/ → /criminal-defense-lawyer/وکیل-رابطه-نامشروع/
RewriteCond %{REQUEST_URI} ^/services/وکیل-رابطه-نامشروع/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D8%B1%D8%A7%D8%A8%D8%B7%D9%87-%D9%86%D8%A7%D9%85%D8%B4%D8%B1%D9%88%D8%B9/?[\s?]
RewriteRule ^ /criminal-defense-lawyer/%D9%88%DA%A9%DB%8C%D9%84-%D8%B1%D8%A7%D8%A8%D8%B7%D9%87-%D9%86%D8%A7%D9%85%D8%B4%D8%B1%D9%88%D8%B9/ [R=301,L,NE]

# انتقال به ساختار جدید خدمات ملکی — بدون noindex
# /services/وکیل-خلع-ید/ → /property-lawyer/وکیل-خلع-ید/
RewriteCond %{REQUEST_URI} ^/services/وکیل-خلع-ید/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D8%AE%D9%84%D8%B9-%DB%8C%D8%AF/?[\s?]
RewriteRule ^ /property-lawyer/%D9%88%DA%A9%DB%8C%D9%84-%D8%AE%D9%84%D8%B9-%DB%8C%D8%AF/ [R=301,L,NE]

# انتقال به ساختار جدید خدمات کیفری — بدون noindex
# /services/وکیل-جنایی/ → /criminal-defense-lawyer/وکیل-جنایی/
RewriteCond %{REQUEST_URI} ^/services/وکیل-جنایی/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D8%AC%D9%86%D8%A7%DB%8C%DB%8C/?[\s?]
RewriteRule ^ /criminal-defense-lawyer/%D9%88%DA%A9%DB%8C%D9%84-%D8%AC%D9%86%D8%A7%DB%8C%DB%8C/ [R=301,L,NE]

# انتقال به ساختار جدید خدمات کیفری — بدون noindex
# /services/وکیل-خیانت-در-امانت/ → /criminal-defense-lawyer/وکیل-خیانت-در-امانت/
RewriteCond %{REQUEST_URI} ^/services/وکیل-خیانت-در-امانت/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D8%AE%DB%8C%D8%A7%D9%86%D8%AA-%D8%AF%D8%B1-%D8%A7%D9%85%D8%A7%D9%86%D8%AA/?[\s?]
RewriteRule ^ /criminal-defense-lawyer/%D9%88%DA%A9%DB%8C%D9%84-%D8%AE%DB%8C%D8%A7%D9%86%D8%AA-%D8%AF%D8%B1-%D8%A7%D9%85%D8%A7%D9%86%D8%AA/ [R=301,L,NE]

# انتقال به ساختار جدید خدمات کیفری — بدون noindex
# /services/وکیل-مواد-مخدر/ → /criminal-defense-lawyer/وکیل-مواد-مخدر/
RewriteCond %{REQUEST_URI} ^/services/وکیل-مواد-مخدر/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D9%88%D8%A7%D8%AF-%D9%85%D8%AE%D8%AF%D8%B1/?[\s?]
RewriteRule ^ /criminal-defense-lawyer/%D9%88%DA%A9%DB%8C%D9%84-%D9%85%D9%88%D8%A7%D8%AF-%D9%85%D8%AE%D8%AF%D8%B1/ [R=301,L,NE]

# هاب کیفری به پیلار وکیل کیفری منتقل شد
# /services/کیفری/ → /criminal-defense-lawyer/
RewriteCond %{REQUEST_URI} ^/services/کیفری/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%DA%A9%DB%8C%D9%81%D8%B1%DB%8C/?[\s?]
RewriteRule ^ /criminal-defense-lawyer/ [R=301,L,NE]

# ریدایرکت روی پیلار مشاوره حقوقی
# /services/بهترین-وکیل/ → /legal-consultation/
RewriteCond %{REQUEST_URI} ^/services/بهترین-وکیل/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D8%A8%D9%87%D8%AA%D8%B1%DB%8C%D9%86-%D9%88%DA%A9%DB%8C%D9%84/?[\s?]
RewriteRule ^ /legal-consultation/ [R=301,L,NE]

# فهرست /services/ حذف شد؛ پنج پیلار جایگزین آن است
# /services/ → /
RewriteCond %{REQUEST_URI} ^/services/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/?[\s?]
RewriteRule ^ / [R=301,L,NE]

# مشاوره حقوقی صفحه پیلار مستقل دارد
# /services/moshavere-hoghooghi/ → /legal-consultation/
RewriteCond %{REQUEST_URI} ^/services/moshavere-hoghooghi/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/moshavere-hoghooghi/?[\s?]
RewriteRule ^ /legal-consultation/ [R=301,L,NE]

# تبدیل به بلاگ پست
# /services/سگی-که-خانه-میلیاردی-به-نام-وی-شد/ → /blogs/سگی-که-خانه-میلیاردی-به-نام-وی-شد/
RewriteCond %{REQUEST_URI} ^/services/سگی-که-خانه-میلیاردی-به-نام-وی-شد/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D8%B3%DA%AF%DB%8C-%DA%A9%D9%87-%D8%AE%D8%A7%D9%86%D9%87-%D9%85%DB%8C%D9%84%DB%8C%D8%A7%D8%B1%D8%AF%DB%8C-%D8%A8%D9%87-%D9%86%D8%A7%D9%85-%D9%88%DB%8C-%D8%B4%D8%AF/?[\s?]
RewriteRule ^ /blogs/%D8%B3%DA%AF%DB%8C-%DA%A9%D9%87-%D8%AE%D8%A7%D9%86%D9%87-%D9%85%DB%8C%D9%84%DB%8C%D8%A7%D8%B1%D8%AF%DB%8C-%D8%A8%D9%87-%D9%86%D8%A7%D9%85-%D9%88%DB%8C-%D8%B4%D8%AF/ [R=301,L,NE]

# تبدیل به بلاگ پست
# /services/احکام-صادره-برای-املاک-خاص/ → /blogs/احکام-صادره-برای-املاک-خاص/
RewriteCond %{REQUEST_URI} ^/services/احکام-صادره-برای-املاک-خاص/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D8%A7%D8%AD%DA%A9%D8%A7%D9%85-%D8%B5%D8%A7%D8%AF%D8%B1%D9%87-%D8%A8%D8%B1%D8%A7%DB%8C-%D8%A7%D9%85%D9%84%D8%A7%DA%A9-%D8%AE%D8%A7%D8%B5/?[\s?]
RewriteRule ^ /blogs/%D8%A7%D8%AD%DA%A9%D8%A7%D9%85-%D8%B5%D8%A7%D8%AF%D8%B1%D9%87-%D8%A8%D8%B1%D8%A7%DB%8C-%D8%A7%D9%85%D9%84%D8%A7%DA%A9-%D8%AE%D8%A7%D8%B5/ [R=301,L,NE]

# تبدیل به بلاگ پست
# /services/اصل-۴۹-قانون-اساسی/ → /blogs/اصل-۴۹-قانون-اساسی/
RewriteCond %{REQUEST_URI} ^/services/اصل-۴۹-قانون-اساسی/?$ [OR]
RewriteCond %{THE_REQUEST} \s/services/%D8%A7%D8%B5%D9%84-%DB%B4%DB%B9-%D9%82%D8%A7%D9%86%D9%88%D9%86-%D8%A7%D8%B3%D8%A7%D8%B3%DB%8C/?[\s?]
RewriteRule ^ /blogs/%D8%A7%D8%B5%D9%84-%DB%B4%DB%B9-%D9%82%D8%A7%D9%86%D9%88%D9%86-%D8%A7%D8%B3%D8%A7%D8%B3%DB%8C/ [R=301,L,NE]

# END majd:legacy-redirects


  # Prefer trailing-slash URLs (matches Next trailingSlash: true)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # Legacy blog URLs
  RewriteRule ^blog/post/(.+)/?$ /blogs/$1/ [R=301,L]
  RewriteRule ^blog/?$ /blogs/ [R=301,L]

  # Blog post shell: /blogs/<slug>/ → /blogs/view/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^blogs/[^/]+/?$ /blogs/view/index.html [L]

  # Categorized service pages: /{prefix}/<slug>/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(family-lawyer|property-lawyer|criminal-defense-lawyer|legal-consultation|administrative-lawyer)/[^/]+/?$ /services/detail/index.html [L]

  # Leftover /services/<slug>/ bookmarks — SPA then client-canonicalizes.
  # Exact /services/ is a 301 in the generated block above.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^services/.+$ /services/detail/index.html [L]

  # Shop product shell
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^shop/product/.+$ /shop/product/index.html [L]

  # Course detail shell
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^courses/view/.+$ /courses/view/index.html [L]
</IfModule>
